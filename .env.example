# CryptoMonitor 凭据模板 (可选, 仅在重新生成 service 单元时使用)
# ====================================================================
# 自 Milestone 1 起, 凭据已直接固化在 systemd service 单元里 (单一事实源).
# .env 文件只在以下场景有用:
#   1. 重新跑 deploy/systemd-install.sh 时, 脚本会从 .env 读取一次性注入 service
#   2. 在 shell 里手动 source 测试:  set -a && . ./.env && set +a
#
# 注意:
# - .env 已被 .gitignore 过滤, 不会入库
# - 格式: KEY="value" (双引号可选, 等号两侧无空格, 不要 export 前缀)
# - 注释用 # 开头, 必须独占一行

# Telegram Bot (从 @BotFather 获取)
TG_BOT_TOKEN=""

# Telegram 目标 chat_id (用户 / 群组 / 频道均可, 须为数字)
TG_CHAT_ID=""

# DeepSeek API Key (LLM 通道, 当前代码已禁用, 留空即可)
DEEPSEEK_API_KEY=""
